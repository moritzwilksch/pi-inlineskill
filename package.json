{
  "name": "@moritzwilksch/pi-inlineskill",
  "version": "0.1.0",
  "description": "Expand skill references anywhere in a Pi prompt.",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/moritzwilksch/pi-inlineskill#readme",
  "bugs": {
    "url": "https://github.com/moritzwilksch/pi-inlineskill/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moritzwilksch/pi-inlineskill.git"
  },
  "files": [
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "test": "node --test index.test.ts",
    "check": "tsc",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "git-cliff": "2.14.2",
    "lefthook": "2.2.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
